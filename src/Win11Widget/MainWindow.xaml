<Window
    x:Class="Win11Widget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Win11Widget"
    Title="Win11 Widget - Countdown Timers"
    Width="500"
    Height="600"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize">
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6E6E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#D13438"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A52A2D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Border Background="#F5F5F5" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Background="#0078D4" CornerRadius="12,12,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⏱️ Countdown Timers" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="−" Background="Transparent" Foreground="White" BorderThickness="0" 
                            FontSize="20" Padding="8" Cursor="Hand" Click="MinimizeButton_Click" Margin="0,0,8,0"
                            ToolTip="Minimize to Tray"/>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="White" BorderThickness="0" 
                            FontSize="16" Padding="8" Cursor="Hand" Click="CloseButton_Click"
                            ToolTip="Minimize to Tray"/>
                </Grid>
            </Border>
        
            <!-- Countdowns List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20" Background="White">
                <ItemsControl x:Name="CountdownsItemsControl" ItemsSource="{Binding Countdowns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                    CornerRadius="8" Padding="20" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E0E0E0" Opacity="0.5" BlurRadius="8" ShadowDepth="2"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="0" Background="#E8F4FD" Width="48" Height="48" 
                                            CornerRadius="24" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="📅" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15" Foreground="#1F1F1F" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="20" FontWeight="Bold" Foreground="#0078D4"/>
                                    </StackPanel>
                                    
                                    <!-- Actions -->
                                    <Button Grid.Column="2" Content="🗑️" Click="RemoveCountdownButton_Click" 
                                            Tag="{Binding}" Padding="12,8" Background="#FFF4F4" 
                                            BorderThickness="0" Cursor="Hand" ToolTip="Remove Countdown"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#FFF4F4"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFE5E5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" 
                    Padding="20,16" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="➕ Add Countdown" Click="AddCountdownButton_Click" 
                            Style="{StaticResource ModernButton}" Margin="0,0,10,0" />
                    <Button Content="⚙️ Settings" Click="SettingsButton_Click" 
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
