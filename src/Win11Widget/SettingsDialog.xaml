<Window
    x:Class="Win11Widget.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Widget Settings"
    Width="550"
    Height="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel>
                                <Border Background="#F8F8F8" Padding="12,8" CornerRadius="8,8,0,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ContentPresenter Margin="16"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0078D4" CornerRadius="12,12,0,0" Padding="24,16">
                <TextBlock Text="⚙️ Settings" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- Display Settings -->
                    <GroupBox Style="{StaticResource ModernGroupBox}">
                        <GroupBox.Header>
                            <TextBlock Text="🎨 Display Settings" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                        </GroupBox.Header>
                        <StackPanel>
                            <TextBlock Text="Font Size" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Slider x:Name="FontSizeSlider" Width="280" Minimum="10" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" />
                                <Border Background="#E8F4FD" CornerRadius="4" Padding="12,4" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ElementName=FontSizeSlider, Path=Value}" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Foreground Color" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                            <TextBox x:Name="ForegroundColorTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" />

                            <TextBlock Text="Background Color" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                            <TextBox x:Name="BackgroundColorTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" />

                            <TextBlock Text="Opacity" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Slider x:Name="OpacitySlider" Width="280" Minimum="0.1" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                <Border Background="#E8F4FD" CornerRadius="4" Padding="12,4" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat=P0}" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always On Top" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <!-- Position Settings -->
                    <GroupBox Style="{StaticResource ModernGroupBox}">
                        <GroupBox.Header>
                            <TextBlock Text="📍 Position Settings" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X Position" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                                    <TextBox x:Name="PositionXTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y Position" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,8" />
                                    <TextBox x:Name="PositionYTextBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Quick Positions" FontSize="12" FontWeight="SemiBold" Foreground="#666666" Margin="0,16,0,8" />
                            <WrapPanel>
                                <Button Content="↖ Top Left" Click="TopLeft_Click" Style="{StaticResource QuickButton}" Margin="0,0,8,8" />
                                <Button Content="↗ Top Right" Click="TopRight_Click" Style="{StaticResource QuickButton}" Margin="0,0,8,8" />
                                <Button Content="⊙ Center" Click="Center_Click" Style="{StaticResource QuickButton}" Margin="0,0,8,8" />
                                <Button Content="↙ Bottom Left" Click="BottomLeft_Click" Style="{StaticResource QuickButton}" Margin="0,0,8,8" />
                                <Button Content="↘ Bottom Right" Click="BottomRight_Click" Style="{StaticResource QuickButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Sound Settings -->
                    <GroupBox Style="{StaticResource ModernGroupBox}">
                        <GroupBox.Header>
                            <TextBlock Text="🔔 Sound Settings" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                        </GroupBox.Header>
                        <CheckBox x:Name="SoundsEnabledCheckBox" Content="Enable Sound Notifications" FontSize="13" />
                    </GroupBox>

                    <!-- Notification Settings -->
                    <GroupBox Style="{StaticResource ModernGroupBox}">
                        <GroupBox.Header>
                            <TextBlock Text="⏰ Event Reminders" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                        </GroupBox.Header>
                        <StackPanel>
                            <CheckBox x:Name="NotificationsEnabledCheckBox" Content="Enable Event Reminders" 
                                      FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />
                            
                            <StackPanel Margin="24,0,0,0">
                                <CheckBox x:Name="NotifyOneDayBeforeCheckBox" Content="Remind me 1 day before" 
                                          FontSize="13" Margin="0,0,0,8" />
                                <CheckBox x:Name="NotifyOneHourBeforeCheckBox" Content="Remind me 1 hour before" 
                                          FontSize="13" Margin="0,0,0,8" />
                                <CheckBox x:Name="NotifyAtEventCheckBox" Content="Notify when event happens" 
                                          FontSize="13" />
                            </StackPanel>
                            
                            <TextBlock Text="Notifications are checked every 5 minutes" 
                                       FontSize="11" Foreground="#666666" Margin="0,12,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" 
                    Padding="24,16" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" 
                            Width="100" Margin="0,0,12,0" IsCancel="True" />
                    <Button Content="Save" Click="SaveButton_Click" Style="{StaticResource ModernButton}" 
                            Width="100" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
